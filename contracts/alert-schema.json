{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standardized Threat Alert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "flow_id",
    "threat_class",
    "confidence",
    "severity",
    "evidence"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "flow_id": {
      "type": "string"
    },
    "threat_class": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence-schema.json"
      }
    },
    "source_ip": {
      "type": [
        "string",
        "null"
      ]
    },
    "destination_ip": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
